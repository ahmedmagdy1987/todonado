<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!--
    THE ROOT IS DELIBERATELY ABSENT.

    `/` is inside ProtectedRoute: a signed-out visitor is redirected to
    /welcome and a signed-in one lands in the app, so the root shows marketing
    copy to nobody. It now declares /welcome as its canonical, and a sitemap
    should only ever list canonical URLs, so listing both would ask search
    engines to index a page that immediately points at another one.
  -->
  <url>
    <loc>https://www.todonado.com/welcome</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.todonado.com/pricing</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://www.todonado.com/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://www.todonado.com/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://www.todonado.com/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
