{
  /*
   * Type-checks the Vercel serverless functions in `api/`.
   *
   * These were previously checked by NOTHING (tsconfig.app.json includes only
   * `src`, tsconfig.node.json only the vite/vitest configs), which is how a
   * module-load crash shipped with CI green.
   *
   * `module`/`moduleResolution: NodeNext` is deliberate and load-bearing: with
   * package.json `"type": "module"` these files are ESM, so NodeNext makes an
   * extensionless relative import a COMPILE ERROR ("Relative import paths need
   * explicit file extensions") instead of a production
   * FUNCTION_INVOCATION_FAILED at module load.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "ES2023",
    /* NO "DOM": these run on Node. Request/Response/Headers come from
       @types/node (undici), which is what the runtime actually provides —
       mixing in DOM produces a conflicting BodyInit and false errors. */
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  /* Leaf modules from src/ that the functions import by relative path. Both are
     dependency-free (no `@/`, no import.meta, no browser globals) so they type-
     check and bundle cleanly in the Node runtime. */
  "include": [
    "api/**/*.ts",
    "src/features/billing/webhookMapping.ts",
    "src/features/billing/planCore.ts",
    "src/features/billing/entitlements.ts"
  ]
}
