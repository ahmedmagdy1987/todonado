# Todonado environment variables
# Copy this file to `.env` and fill in values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).
# NEVER commit the real .env file — it is gitignored.

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Your Supabase "anon" / public key (safe for the browser; RLS protects data)
VITE_SUPABASE_ANON_KEY=
